    </button>

  </div>

</div>


<!-- =========================
     MAP
========================= -->

<div id="map"></div>


<!-- =========================
     TOOLBAR
========================= -->

<div id="topBar" style="display:none">

  <button class="toolButton" onclick="selectTool('select')">
    Select
  </button>

  <button class="toolButton" onclick="selectTool('polygon')">
    Polygon
  </button>

  <button class="toolButton" onclick="selectTool('curve')">
    Curved Line
  </button>

  <button class="toolButton" onclick="selectTool('line')">
    Line
  </button>

  <button class="toolButton" onclick="selectTool('marker')">
    Marker
  </button>

  <button class="toolButton" onclick="selectTool('text')">
    Text
  </button>

  <button class="toolButton" onclick="selectTool('delete')">
    Delete
  </button>

  <button class="toolButton" onclick="undo()">
    ↶
  </button>

