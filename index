<!-- =========================
     START SCREEN
========================= -->

<div id="startScreen">

  <h1>War Map Sandbox</h1>

  <p>Create and edit your own tactical map</p>

  <div class="startButtons">

    <button class="startButton" onclick="startOSM()">
      <div class="icon">🌍</div>
      <strong>OpenStreetMap</strong>
      <small>Real-world map</small>
    </button>

    <button class="startButton" onclick="openUpload()">
