     SETTINGS
========================= -->

<div id="settingsPanel">

  <h3>Object Settings</h3>

  <div class="settingRow">
    <label>Color</label>
    <input id="colorPicker" type="color" value="#ff0000">
  </div>

  <div class="settingRow">
    <label>Opacity</label>
