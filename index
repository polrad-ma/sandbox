    ↷
  </button>

  <button class="toolButton" onclick="toggleLayers()">
    Layers
  </button>

  <button class="toolButton" onclick="toggleSettings()">
    ⚙
  </button>

  <button class="toolButton" onclick="newMap()">
    New
  </button>

</div>


<!-- =========================
     LAYERS
